# Copy to .env and replace every placeholder. Never commit .env.
#
# Production (docker compose): the compose file sets NODE_ENV=production, PORT=9000
# and builds DATABASE_URL / DIRECT_URL from the POSTGRES_* values below using the
# internal "postgres" hostname. The URLs below are used for local `npm run dev`.

# ── Database ─────────────────────────────────
# If the password contains special characters, URL-encode it in these URLs.
DATABASE_URL="postgresql://tnja:change_me_db_password@localhost:5433/tnja?schema=public"
DIRECT_URL="postgresql://tnja:change_me_db_password@localhost:5433/tnja?schema=public"

# Postgres container credentials (required by docker-compose)
POSTGRES_USER=tnja
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=tnja

# ── Server ───────────────────────────────────
PORT=9000
NODE_ENV="development"

# ── Authentication ───────────────────────────
# Required in production: at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret"
# Super admin login is disabled unless both are set. Use a strong password (12+ chars).
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace_with_a_strong_password"

# ── Frontend / CORS ──────────────────────────
# Used for password reset links and allowed as a CORS origin.
# Production: https://tnja-329-2017.in
FRONTEND_URL="http://localhost:3000"
# Optional extra allowed origins, comma-separated (e.g. https://www.tnja-329-2017.in)
CORS_ORIGINS=""

# ── Razorpay ─────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_yourkeyhere"
RAZORPAY_KEY_SECRET="yourrazorpaysecret"

# ── SMTP Email ───────────────────────────────
# Port 465 = implicit TLS, 587 = STARTTLS. For Gmail use an App Password.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your_login@smtp-brevo.com"
SMTP_PASS="xsmtpsib-your-brevo-smtp-key"
SMTP_FROM_NAME="Tamil Nadu Judo Association"
# Verified sender in Brevo (Senders, Domains & Dedicated IPs). Defaults to SMTP_USER.
SMTP_FROM_EMAIL="noreply@your-domain.in"

# ── Sandbox (Aadhaar verification via DigiLocker) ──────────────
# https://developer.sandbox.co.in — Aadhaar verification is disabled unless key and secret are set.
# DigiLocker must be enabled for the Sandbox account.
SANDBOX_BASE_URL=https://api.sandbox.co.in
SANDBOX_API_KEY="key_live_yourkeyhere"
SANDBOX_API_SECRET="secret_live_yoursecrethere"
SANDBOX_API_VERSION=1.0.0
# Page DigiLocker returns to after consent; must be public HTTPS.
# Defaults to FRONTEND_URL/digilocker-callback when FRONTEND_URL is https, else the production site.
# DIGILOCKER_REDIRECT_URL=https://tnja-329-2017.in/digilocker-callback
